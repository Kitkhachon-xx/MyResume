---
import repos from '../data/repos.json';

const github = 'https://github.com/Kitkhachon-xx';
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en', { month: 'short', year: 'numeric' });
---

<section class="block reveal" id="repos">
  <h2 class="section-title">Repositories</h2>
  <p class="repos-hint">
    <span class="hint-3d">Drag to rotate · scroll to zoom · hover (or tap) a repo for details · click to open</span>
    <a href={github} target="_blank" rel="noopener">All repos on GitHub →</a>
  </p>

  <div class="repos" id="repo-graph-root" data-repos={JSON.stringify(repos)} data-github={github}>
    <div class="repo-stage" id="repo-stage" aria-label="Interactive 3D graph of my GitHub repositories">
      <div class="repo-card" id="repo-card" hidden></div>
    </div>

    <ul class="repo-grid">
      {repos.map((r) => (
        <li class="card repo-item">
          {r.thumb && <img src={r.thumb} alt="" loading="lazy" width="1200" height="600" />}
          <h3><a href={r.url} target="_blank" rel="noopener">{r.name}</a></h3>
          <p>{r.description ?? 'No description yet'}</p>
          <p class="repo-meta">{r.language ?? 'n/a'} · ★ {r.stars} · Updated {fmt(r.updated)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  type Repo = {
    name: string; url: string; homepage: string | null; description: string | null;
    language: string | null; stars: number; forks: number; topics: string[];
    updated: string; thumb: string | null;
  };

  const LANG_COLORS: Record<string, string> = {
    Python: '#3572A5', 'Jupyter Notebook': '#DA5B0B', Java: '#b07219', HTML: '#e34c26',
    TypeScript: '#3178c6', Astro: '#ff5a03', JavaScript: '#f1e05a', CSS: '#563d7c',
  };
  const langColor = (l: string | null) => (l && LANG_COLORS[l]) || '#8b8fa8';

  const root = document.getElementById('repo-graph-root') as HTMLElement;
  const stage = document.getElementById('repo-stage') as HTMLElement;
  const card = document.getElementById('repo-card') as HTMLElement;
  const section = document.getElementById('repos') as HTMLElement;
  const repos: Repo[] = JSON.parse(root.dataset.repos || '[]');
  const githubUrl = root.dataset.github!;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch { return false; }
  }

  let started = false;
  async function start() {
    if (started || !repos.length || !hasWebGL()) return;
    started = true;
    try {
      const [{ default: ForceGraph3D }, THREE] = await Promise.all([
        import('3d-force-graph'),
        import('three'),
      ]);
      build(ForceGraph3D, THREE);
      root.classList.add('is-3d');
    } catch (e) {
      console.warn('3D graph unavailable, showing grid', e);
    }
  }

  function textureFromCanvas(THREE: any, draw: (ctx: CanvasRenderingContext2D, w: number, h: number) => void, w = 480, h = 240) {
    const c = document.createElement('canvas');
    c.width = w; c.height = h;
    draw(c.getContext('2d')!, w, h);
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    return t;
  }

  function fallbackDraw(name: string, color: string) {
    return (ctx: CanvasRenderingContext2D, w: number, h: number) => {
      ctx.fillStyle = color; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(0,0,0,0.35)'; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = '#fff'; ctx.font = 'bold 34px sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(name.length > 22 ? name.slice(0, 21) + '…' : name, w / 2, h / 2);
    };
  }

  function roundedFrame(ctx: CanvasRenderingContext2D, w: number, h: number, color: string) {
    ctx.strokeStyle = color; ctx.lineWidth = 10;
    ctx.strokeRect(5, 5, w - 10, h - 10);
  }

  type Group = {
    id: string; label: string; color: string; repos: Repo[]; url: string;
    radius: number; tilt: [number, number]; speed: number; phase: number;
  };

  const TILTS: [number, number][] = [[0.35, 0.15], [-0.4, 0.3], [0.2, -0.45], [0.5, 0.1]];
  const SPEEDS = [0.14, -0.1, 0.08, -0.06];

  function buildGroups(): Group[] {
    const byLang = new Map<string, Repo[]>();
    for (const r of repos) {
      if (!r.language) continue;
      byLang.set(r.language, [...(byLang.get(r.language) || []), r]);
    }
    const multi = [...byLang.entries()].filter(([, l]) => l.length >= 2).sort((a, b) => a[1].length - b[1].length);
    const multiNames = new Set(multi.map(([n]) => n));
    const base = multi.map(([lang, list]) => ({
      label: lang, color: langColor(lang), repos: list,
      url: `${githubUrl}?tab=repositories&language=${encodeURIComponent(lang)}`,
    }));
    const other = repos.filter((r) => !r.language || !multiNames.has(r.language));
    if (other.length) base.push({ label: 'Other', color: '#8b8fa8', repos: other, url: `${githubUrl}?tab=repositories` });
    return base.map((g, i) => ({
      ...g,
      id: `group:${g.label}`,
      radius: 85 + i * 50,
      tilt: TILTS[i % TILTS.length],
      speed: SPEEDS[i % SPEEDS.length],
      phase: i * 1.7,
    }));
  }

  function build(ForceGraph3D: any, THREE: any) {
    const groups = buildGroups();
    const nodes: any[] = [{ id: '__me', kind: 'me', fx: 0, fy: 0, fz: 0, x: 0, y: 0, z: 0 }];
    const links: any[] = [];
    for (const g of groups) {
      nodes.push({ id: g.id, kind: 'hub', group: g, idx: 0 });
      links.push({ source: '__me', target: g.id, color: g.color, width: 2 });
      g.repos.forEach((r, i) => {
        nodes.push({ id: r.name, kind: 'repo', repo: r, group: g, idx: i + 1 });
        links.push({ source: g.id, target: r.name, color: g.color, width: 1.1 });
      });
    }

    // Fixed orbit layout: every ring is a tilted circle around you; nodes spin along it.
    const euler = new THREE.Euler();
    const pos = (n: any, t: number) => {
      const g: Group = n.group;
      const count = g.repos.length + 1;
      const a = (n.idx / count) * Math.PI * 2 + g.phase + g.speed * t;
      euler.set(g.tilt[0], 0, g.tilt[1]);
      return new THREE.Vector3(Math.cos(a) * g.radius, 0, Math.sin(a) * g.radius).applyEuler(euler);
    };
    const layout = (t: number) => {
      for (const n of nodes) {
        if (n.kind === 'me') continue;
        const p = pos(n, t);
        n.fx = n.x = p.x; n.fy = n.y = p.y; n.fz = n.z = p.z;
      }
    };
    layout(0);

    const loader = new THREE.TextureLoader();
    loader.setCrossOrigin('anonymous');

    const makeSprite = (n: any) => {
      let sprite: any;
      if (n.kind === 'me') {
        const mat = new THREE.SpriteMaterial({
          map: textureFromCanvas(THREE, (ctx, w, h) => {
            ctx.fillStyle = '#4f46e5'; ctx.beginPath(); ctx.arc(w / 2, h / 2, h / 2 - 4, 0, Math.PI * 2); ctx.fill();
          }, 256, 256),
          transparent: true, depthTest: false,
        });
        sprite = new THREE.Sprite(mat);
        sprite.scale.set(38, 38, 1);
        const img = new Image();
        img.onload = () => {
          mat.map = textureFromCanvas(THREE, (ctx, w, h) => {
            ctx.save(); ctx.beginPath(); ctx.arc(w / 2, h / 2, h / 2 - 10, 0, Math.PI * 2); ctx.clip();
            ctx.drawImage(img, 0, 0, w, h); ctx.restore();
            ctx.strokeStyle = '#8b87ff'; ctx.lineWidth = 10;
            ctx.beginPath(); ctx.arc(w / 2, h / 2, h / 2 - 8, 0, Math.PI * 2); ctx.stroke();
          }, 256, 256);
          mat.needsUpdate = true;
        };
        img.src = '/profile.jpg';
      } else if (n.kind === 'hub') {
        const g: Group = n.group;
        const mat = new THREE.SpriteMaterial({
          map: textureFromCanvas(THREE, (ctx, w, h) => {
            ctx.fillStyle = g.color; ctx.beginPath(); ctx.arc(w / 2, h / 2, h / 2 - 6, 0, Math.PI * 2); ctx.fill();
            ctx.strokeStyle = 'rgba(255,255,255,0.85)'; ctx.lineWidth = 8; ctx.stroke();
            ctx.fillStyle = '#fff'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            const words = g.label.split(' ');
            ctx.font = `bold ${words.length > 1 ? 34 : 40}px sans-serif`;
            words.forEach((wd, i) => ctx.fillText(wd, w / 2, h / 2 - 14 + i * 40 - (words.length - 1) * 10));
            ctx.font = '28px sans-serif';
            ctx.fillText(`${g.repos.length} repos`, w / 2, h / 2 + 52);
          }, 256, 256),
          transparent: true, depthTest: false,
        });
        sprite = new THREE.Sprite(mat);
        sprite.scale.set(34, 34, 1);
      } else {
        const color = langColor(n.repo.language);
        const mat = new THREE.SpriteMaterial({
          map: textureFromCanvas(THREE, fallbackDraw(n.repo.name, color)),
          transparent: true, depthTest: false,
        });
        sprite = new THREE.Sprite(mat);
        sprite.scale.set(52, 26, 1);
        if (n.repo.thumb) {
          loader.load(n.repo.thumb, (t: any) => {
            const c = document.createElement('canvas');
            c.width = 480; c.height = 240;
            const ctx = c.getContext('2d')!;
            ctx.drawImage(t.image, 0, 0, 480, 240);
            roundedFrame(ctx, 480, 240, color);
            const framed = new THREE.CanvasTexture(c);
            framed.colorSpace = THREE.SRGBColorSpace;
            mat.map = framed; mat.needsUpdate = true;
          });
        }
      }
      sprite.renderOrder = 10;
      n.__sprite = sprite;
      n.__vis = 1;
      return sprite;
    };

    // Focus: hovered node + its hub/children stay bright, the rest fades.
    let focus: Set<string> | null = null;
    const endId = (e: any) => (typeof e === 'object' ? e.id : e);
    const inFocus = (l: any) => !focus || (focus.has(endId(l.source)) && focus.has(endId(l.target)));
    const refreshLinks = () => {
      graph.linkColor((l: any) => (inFocus(l) ? l.color : '#7b7f99'));
      graph.linkWidth((l: any) => (inFocus(l) ? l.width : 0.15));
    };
    const setFocus = (n: any) => {
      if (!n || n.kind === 'me') focus = null;
      else {
        const s = new Set<string>(['__me']);
        if (n.kind === 'hub') { s.add(n.id); n.group.repos.forEach((r: Repo) => s.add(r.name)); }
        else { s.add(n.id); s.add(n.group.id); }
        focus = s;
      }
      refreshLinks();
    };

    const graph = ForceGraph3D({ controlType: 'orbit' })(stage)
      .backgroundColor('rgba(0,0,0,0)')
      .showNavInfo(false)
      .graphData({ nodes, links })
      .nodeThreeObject(makeSprite)
      .nodeLabel(() => '')
      .linkOpacity(0.75)
      .enableNodeDrag(false)
      .d3AlphaDecay(0)
      .cooldownTime(Infinity)
      .cooldownTicks(reduced ? 3 : Infinity);
    refreshLinks();
    // 3d-force-graph empties its container on init, so re-attach the hover card.
    stage.appendChild(card);
    // Positions are fixed, so no physics.
    graph.d3Force('charge', null);
    graph.d3Force('link', null);
    graph.d3Force('center', null);

    // Faint orbit rings
    for (const g of groups) {
      const pts: any[] = [];
      for (let i = 0; i <= 128; i++) {
        const a = (i / 128) * Math.PI * 2;
        pts.push(new THREE.Vector3(Math.cos(a) * g.radius, 0, Math.sin(a) * g.radius));
      }
      const ring = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(pts),
        new THREE.LineBasicMaterial({ color: g.color, transparent: true, opacity: 0.35 }),
      );
      ring.rotation.set(g.tilt[0], 0, g.tilt[1]);
      graph.scene().add(ring);
    }

    const camera = graph.camera();
    const frame = () => {
      const aspect = stage.clientWidth / Math.max(1, stage.clientHeight);
      const maxR = groups[groups.length - 1].radius + 30;
      const d = Math.max(430, (maxR * 1.1) / (Math.tan((camera.fov * Math.PI) / 360) * Math.min(1.6, aspect)));
      graph.cameraPosition({ x: 0, y: d * 0.34, z: d * 0.94 }, { x: 0, y: 0, z: 0 }, 0);
    };
    const size = () => { graph.width(stage.clientWidth).height(stage.clientHeight); frame(); };
    size();
    new ResizeObserver(size).observe(stage);

    let hovering = false;
    if (!reduced) {
      const controls = graph.controls();
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.6;
    }

    // Per-frame: spin rings, fade by distance, dim unfocused nodes
    let last = performance.now(), tt = 0;
    const tick = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (!reduced && !hovering) tt += dt;
      if (!reduced) layout(tt);
      for (const n of nodes) {
        const s = n.__sprite;
        if (!s) continue;
        const dist = camera.position.distanceTo(s.position);
        const fade = Math.min(1, Math.max(0.5, 1.2 - (dist - 300) / 500));
        const target = !focus || n.kind === 'me' || focus.has(n.id) ? 1 : 0.18;
        n.__vis += (target - n.__vis) * 0.2;
        s.material.opacity = fade * n.__vis;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    (stage as any).__graph = graph;
    (stage as any).__nodes = nodes;

    // Hover card
    let lastMouse = { x: 0, y: 0 };
    const place = () => {
      const pad = 16;
      const w = card.offsetWidth, h = card.offsetHeight;
      let x = lastMouse.x + 18, y = lastMouse.y + 18;
      if (x + w > stage.clientWidth - pad) x = lastMouse.x - w - 18;
      if (y + h > stage.clientHeight - pad) y = lastMouse.y - h - 18;
      card.style.transform = `translate(${Math.max(pad, x)}px, ${Math.max(pad, y)}px)`;
    };
    stage.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      lastMouse = { x: e.clientX - r.left, y: e.clientY - r.top };
      if (!card.hidden) place();
    });

    const el = (tag: string, cls?: string, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };
    const rel = (iso: string) => {
      const days = Math.round((new Date(iso).getTime() - Date.now()) / 864e5);
      const f = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
      if (Math.abs(days) < 30) return f.format(days, 'day');
      if (Math.abs(days) < 365) return f.format(Math.round(days / 30), 'month');
      return f.format(Math.round(days / 365), 'year');
    };

    const showCard = (n: any) => {
      card.replaceChildren();
      if (n.kind === 'me') {
        card.append(el('h4', undefined, 'Kitkhachon-xx'), el('p', 'rc-desc', `${repos.length} public repositories. Click to open my GitHub profile.`));
      } else if (n.kind === 'hub') {
        const g: Group = n.group;
        card.append(el('h4', undefined, g.label), el('p', 'rc-desc', `${g.repos.length} repositories: ${g.repos.map((r) => r.name).join(', ')}`));
        card.append(el('p', 'rc-links', 'Click to view on GitHub'));
      } else {
        const r: Repo = n.repo;
        if (r.thumb) {
          const img = el('img') as HTMLImageElement;
          img.src = r.thumb; img.alt = ''; img.width = 1200; img.height = 600;
          card.append(img);
        }
        card.append(el('h4', undefined, r.name));
        card.append(el('p', 'rc-desc', r.description ?? 'No description yet'));
        const meta = el('p', 'rc-meta');
        const dot = el('span', 'rc-dot'); dot.style.background = langColor(r.language);
        meta.append(dot, `${r.language ?? 'n/a'} · ★ ${r.stars} · ⑂ ${r.forks} · Updated ${rel(r.updated)}`);
        card.append(meta);
        if (r.topics.length) {
          const t = el('div', 'rc-topics');
          r.topics.forEach((x) => t.append(el('span', 'chip', x)));
          card.append(t);
        }
        const links = el('p', 'rc-links');
        links.append(el('span', undefined, 'Click to open repo'));
        if (r.homepage) links.append(el('span', undefined, ' · has homepage'));
        card.append(links);
      }
      card.hidden = false;
      place();
    };

    const open = (n: any) => {
      const url = n.kind === 'me' ? githubUrl : n.kind === 'hub' ? n.group.url : n.repo.url;
      window.open(url, '_blank', 'noopener');
    };

    let active: any = null;
    graph.onNodeHover((n: any) => {
      stage.style.cursor = n ? 'pointer' : 'grab';
      hovering = !!n;
      if (!reduced) graph.controls().autoRotate = !n;
      if (coarse) return;
      active = n;
      setFocus(n);
      if (n) showCard(n); else card.hidden = true;
    });
    graph.onNodeClick((n: any) => {
      if (coarse && active !== n) {
        active = n; setFocus(n); showCard(n);
        const p = graph.graph2ScreenCoords(n.x, n.y, n.z);
        lastMouse = { x: p.x, y: p.y }; place();
        return;
      }
      open(n);
    });
    graph.onBackgroundClick(() => { active = null; setFocus(null); card.hidden = true; });
  }

  // Lazy-load the 3D library only when the section is near the viewport
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); start(); }
    }, { rootMargin: '300px' });
    io.observe(section);
  } else {
    start();
  }
</script>

<style is:global>
  .repos-hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    margin: -8px 0 16px;
  }
  .repos-hint .hint-3d { display: none; }
  #repos:has(.is-3d) .hint-3d { display: inline; }

  .repo-stage {
    display: none;
    position: relative;
    height: min(70vh, 640px);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 40%, var(--accent-soft), transparent 70%),
      var(--surface);
    box-shadow: var(--shadow);
    cursor: grab;
    touch-action: none;
  }
  .repos.is-3d .repo-stage { display: block; }
  .repos.is-3d .repo-grid { display: none; }

  .repo-card {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: min(300px, calc(100% - 32px));
    padding: 12px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    pointer-events: none;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .repo-card[hidden] { display: none; }
  .repo-card img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin-bottom: 8px;
  }
  .repo-card h4 { margin: 0 0 4px; font-size: 1rem; }
  .repo-card .rc-desc { margin: 0 0 8px; color: var(--muted); }
  .repo-card .rc-meta { margin: 0 0 8px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .repo-card .rc-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .repo-card .rc-topics { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .repo-card .chip { font-size: 0.75rem; padding: 1px 8px; }
  .repo-card .rc-links { margin: 0; color: var(--accent); font-weight: 600; }

  .repo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .repo-item { padding: 12px; }
  .repo-item img { width: 100%; height: auto; border-radius: 8px; margin-bottom: 8px; }
  .repo-item h3 { font-size: 1rem; margin: 0 0 4px; word-break: break-word; }
  .repo-item p { margin: 0 0 6px; color: var(--muted); font-size: 0.9rem; }
  .repo-item .repo-meta { font-size: 0.8rem; }
</style>
