---
import Layout from '../layouts/Layout.astro';
import RepoGraph from '../components/RepoGraph.astro';

const name = 'Kitkhachon Chirawongrungrueang';
const email = 'kitkhachonchi@gmail.com';
const github = 'https://github.com/Kitkhachon-xx';

const skills = [
  { title: 'Programming Languages', items: ['Python', 'Java'] },
  { title: 'Web Development', items: ['HTML', 'CSS', 'Bootstrap 5'] },
  { title: 'Machine Learning', items: ['Optimization Algorithms'] },
  { title: 'Database', items: ['MySQL'] },
  { title: 'Version Control', items: ['Git', 'GitHub'] },
  { title: 'Language', items: ['English (CEFR A2)'] },
];

const education = [
  {
    date: '2024 – Present',
    title: "Bachelor's Degree",
    sub: 'Computer Engineering and Artificial Intelligence · Faculty of Engineering and Technology',
    school: 'Panyapiwat Institute of Management',
    gpa: '3.95',
  },
  {
    date: '2021 – 2023',
    title: 'Senior High School',
    sub: 'Science-Mathematics Program',
    school: 'Songphinong Witthaya School',
    gpa: '3.86',
  },
];
---

<Layout
  title="Kitkhachon Chirawongrungrueang | Resume"
  description="Computer Engineering and AI student seeking a developer internship. Python, Java, Machine Learning."
>
  <nav class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#top">KC</a>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#education">Education</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#repos">Repos</a></li>
      </ul>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="icon sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </nav>

  <header class="hero" id="top">
    <div class="container hero-grid">
      <img class="avatar" src="/profile.jpg" alt={`Portrait of ${name}`} width="200" height="200" />
      <div>
        <p class="eyebrow">Open to internships</p>
        <h1>{name}</h1>
        <p class="role">Computer Engineering &amp; Artificial Intelligence student</p>
        <p class="meta">
          Faculty of Engineering and Technology ·
          <a href="https://pim.ac.th" target="_blank" rel="noopener">Panyapiwat Institute of Management</a>
        </p>
        <div class="btn-row">
          <a class="btn primary" href={`mailto:${email}`}>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            Email me
          </a>
          <a class="btn" href={github} target="_blank" rel="noopener">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
            GitHub
          </a>
          <a class="btn" href="/cv.pdf" download>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16"/></svg>
            Download CV
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="block reveal" id="about">
      <h2 class="section-title">About me</h2>
      <div class="card">
        <p class="about-text">
          I studied in the Science-Mathematics Program at Songphinong Witthaya School (GPA 3.86) and
          now study Computer Engineering and Artificial Intelligence at Panyapiwat Institute of
          Management. I'm looking for an internship to grow as a developer, building and improving
          programs that meet customer requirements, and optimizing Machine Learning models for data
          prediction.
        </p>
        <div class="facts">
          <div class="fact">
            <h3>Favorite subjects</h3>
            <p>Artificial Intelligence, Object-Oriented Programming, Database, Fundamentals for Programming</p>
          </div>
          <div class="fact">
            <h3>Hobbies</h3>
            <p>Reading novels, learning Machine Learning and Deep Learning with Scikit-learn, playing video games, listening to music</p>
          </div>
        </div>
      </div>
    </section>

    <section class="block reveal" id="education">
      <h2 class="section-title">Education</h2>
      <ol class="timeline">
        {education.map((e) => (
          <li>
            <div class="card">
              <span class="tl-date">{e.date}</span>
              <h3>{e.title}</h3>
              <p class="tl-sub">{e.sub}</p>
              <p class="tl-sub">{e.school}</p>
              <span class="pill">GPA {e.gpa}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block reveal" id="skills">
      <h2 class="section-title">Skills</h2>
      <div class="skills-grid">
        {skills.map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <div class="chips">
              {s.items.map((i) => <span class="chip">{i}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="block reveal" id="projects">
      <h2 class="section-title">Projects</h2>
      <article class="card project">
        <h3>Machine Learning Optimization: House Price Prediction</h3>
        <ul>
          <li>Optimized machine learning algorithms for data forecasting using NumPy, Pandas and Matplotlib.</li>
          <li>Applied data preprocessing such as normalization to prepare the dataset for better training.</li>
          <li>Improved model accuracy by tuning hyperparameters with Gradient Descent, finding the minimum error with a tuned learning rate.</li>
          <li>Reached an error rate of 0.00068 after 800 epochs.</li>
        </ul>
        <a class="btn" href="https://github.com/Kitkhachon-xx/Math_AI_Project" target="_blank" rel="noopener">View on GitHub</a>
      </article>
    </section>
    <RepoGraph />
  </main>

  <footer>
    <div class="container">
      © {new Date().getFullYear()} {name} ·
      <a href="https://github.com/Kitkhachon-xx/MyResume" target="_blank" rel="noopener">Source</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var current = root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      var reveals = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        reveals.forEach(function (el) { el.classList.add('visible'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1 });
        reveals.forEach(function (el) { io.observe(el); });
      }

      var links = document.querySelectorAll('.nav-links a');
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            links.forEach(function (a) {
              a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id);
            });
          }
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      document.querySelectorAll('main section[id]').forEach(function (s) { spy.observe(s); });
    })();
  </script>
</Layout>
